# ============================================================
# DIPLOMA HUB — ENVIRONMENT VARIABLES TEMPLATE
# File: .env.example
# Version: 2.0.0
# Updated: 2026-09
#
# HOW TO USE:
#   1. Copy this file to `.env`:
#        cp .env.example .env
#   2. Fill in real values below.
#   3. NEVER commit `.env` to Git (it's in .gitignore).
#   4. Restart the server after editing.
#
# ⚠️  SECURITY WARNING:
#   - `SUPABASE_SERVICE_KEY` bypasses Row Level Security.
#     NEVER expose it to the frontend, NEVER commit it,
#     NEVER paste it in public chats.
#   - Rotate keys immediately if they leak.
# ============================================================


# ------------------------------------------------------------
# 1. SERVER
# ------------------------------------------------------------
# Port the Express server listens on
PORT=3000

# Node environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Full URL of the deployed frontend (used for CORS + email redirects)
# On GitHub Pages this is typically:
SITE_URL=https://alam-7.github.io/diploma-hub

# Comma-separated list of additional allowed origins (optional)
# Example: https://myapp.com,https://staging.myapp.com
EXTRA_ORIGINS=


# ------------------------------------------------------------
# 2. SUPABASE
# ------------------------------------------------------------
# Get these from: https://supabase.com/dashboard → your project → Settings → API

# Project URL (starts with https:// and ends with .supabase.co)
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co

# Public anon key — safe to expose to the frontend
# (as long as Row Level Security is enabled on every table)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# Service role key — SERVER ONLY, bypasses RLS
# NEVER send this to the browser or commit it
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME


# ------------------------------------------------------------
# 3. AUTH / SESSION
# ------------------------------------------------------------
# Secret used to sign internal JWTs (if you issue any beyond Supabase)
# Generate a strong random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Session lifetime (seconds) — how long users stay logged in
SESSION_TTL=2592000
# 2592000 = 30 days
# 86400   = 1 day

# Admin session lifetime (seconds) — shorter for security
ADMIN_SESSION_TTL=28800
# 28800 = 8 hours


# ------------------------------------------------------------
# 4. EMAIL (optional — for password reset, verification)
# ------------------------------------------------------------
# Used if you send transactional emails directly (instead of Supabase)
# Leave blank if using Supabase's built-in email service.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DiplomaHub <no-reply@diplomahub.app>


# ------------------------------------------------------------
# 5. STORAGE (optional — for PDFs, images)
# ------------------------------------------------------------
# Supabase Storage bucket names
STORAGE_BUCKET_EQUIPMENT=equipment
STORAGE_BUCKET_NOTES=notes

# Max upload size in MB (server-side limit)
MAX_UPLOAD_MB=20


# ------------------------------------------------------------
# 6. CORS / SECURITY
# ------------------------------------------------------------
# Enable strict mode (production only)
STRICT_CORS=true

# Enable HTTP request logger
ENABLE_LOGGER=true

# Trust reverse proxy headers (needed behind Nginx / Vercel / Railway)
TRUST_PROXY=1


# ------------------------------------------------------------
# 7. ANALYTICS (optional)
# ------------------------------------------------------------
# Google Analytics 4 Measurement ID (frontend only, prefixed with G-)
GA_MEASUREMENT_ID=

# Sentry DSN for error tracking (server + client)
SENTRY_DSN=


# ------------------------------------------------------------
# 8. RATE LIMITING
# ------------------------------------------------------------
# Global rate limit — requests per 15-minute window per IP
RATE_LIMIT_GLOBAL_MAX=600

# Auth endpoint rate limit — stricter
RATE_LIMIT_AUTH_MAX=20

# Write endpoint rate limit
RATE_LIMIT_WRITE_MAX=60


# ------------------------------------------------------------
# 9. FEATURE FLAGS
# ------------------------------------------------------------
# Toggle features without redeploying
ENABLE_SIGNUP=true
ENABLE_GOOGLE_AUTH=true
ENABLE_ADMIN_PANEL=true
ENABLE_AI_ASSISTANT=true
ENABLE_PWA=true


# ------------------------------------------------------------
# 10. DEPLOYMENT
# ------------------------------------------------------------
# Auto-set by most platforms (Railway, Render, Vercel, Fly)
# Leave blank locally.
RAILWAY_ENVIRONMENT=
RENDER=
VERCEL=
FLY_APP_NAME=


# ============================================================
# QUICK START — MINIMUM REQUIRED
# ============================================================
# For the app to work, you MUST set:
#   - SUPABASE_URL
#   - SUPABASE_ANON_KEY
#
# For full functionality (admin panel, backend writes):
#   - SUPABASE_SERVICE_KEY
#   - JWT_SECRET
#
# For production:
#   - SITE_URL
#   - NODE_ENV=production
# ============================================================