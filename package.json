{
  "name": "diploma-hub",
  "version": "2.0.0",
  "description": "DIPLOMA HUB — A modern learning platform for MSBTE Diploma Engineering students with syllabus, notes, practicals, lab manuals, question papers, and study resources.",
  "license": "MIT",
  "author": {
    "name": "Aditya Sharma",
    "email": "alam-7@users.noreply.github.com",
    "url": "https://github.com/alam-7"
  },
  "homepage": "https://alam-7.github.io/diploma-hub/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alam-7/diploma-hub.git"
  },
  "bugs": {
    "url": "https://github.com/alam-7/diploma-hub/issues"
  },
  "keywords": [
    "msbte",
    "diploma",
    "engineering",
    "education",
    "learning-platform",
    "notes",
    "practicals",
    "quiz",
    "question-papers",
    "pwa",
    "supabase",
    "express"
  ],
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prod": "NODE_ENV=production node server.js",
    "test": "echo \"No tests yet\" && exit 0",
    "lint": "echo \"Add eslint to enable linting\" && exit 0",
    "clean": "rm -rf node_modules package-lock.json",
    "fresh": "npm run clean && npm install",
    "deploy:check": "node -e \"console.log('Env:', process.env.NODE_ENV || 'development'); console.log('Port:', process.env.PORT || 3000); console.log('Supabase URL set:', !!process.env.SUPABASE_URL); console.log('Anon key set:', !!process.env.SUPABASE_ANON_KEY); console.log('Service key set:', !!process.env.SUPABASE_SERVICE_KEY);\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "optionalDependencies": {
    "compression": "^1.7.4",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "iOS >= 14",
    "Android >= 10"
  ],
  "config": {
    "defaultPort": 3000,
    "defaultEnv": "development"
  },
  "publishConfig": {
    "access": "public"
  }
}